{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm run sync:theme && portless run expo start",
    "start": "pnpm run dev",
    "android": "pnpm run sync:theme && expo start --android",
    "ios": "pnpm run sync:theme && expo start --ios",
    "lint": "cd ../.. && oxlint apps/mobile",
    "sync:theme": "node ../../scripts/sync-design-system.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/oxanium": "^0.4.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@workspace/backend": "workspace:*",
    "convex": "^1.44.0",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "panelui-native": "0.75.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "uniwind": "1.11.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "portless": {
    "name": "mobile.hitomi"
  }
